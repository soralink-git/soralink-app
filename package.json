    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
