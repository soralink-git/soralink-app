    "verify:public": "node scripts/verify-public-build.mjs",
    "verify:journey": "node scripts/verify-journey.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "drizzle-orm": "0.45.2",
