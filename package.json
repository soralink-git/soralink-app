    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.6",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.5"
