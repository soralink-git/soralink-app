{
  "name": "soralink-notifications",
  "main": "notifications-worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soralink-db",
      "database_id": "dc3cf21f-b757-4c22-9961-76200ffba2f3",
    },
  ],
  "vars": {
    "NOTIFICATIONS_ENABLED": "false",
    "PUBLIC_SITE_URL": "https://soralink.link",
    "EMAIL_FROM": "SoraLink <notifications@soralink.link>",
  },
  // Verify the sender domain with Resend before activation.
  // Store RESEND_API_KEY as a Worker secret, never in this file or on Pages.
  // Enable this Worker first, then the Pages queue with the same sender/site URL.
}
